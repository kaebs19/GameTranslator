    "onboarding.live.point1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت تبدأ البث بنفسك، وسيعرض iOS نافذة تأكيد ومؤشر تسجيل طوال عمله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You start the broadcast yourself. iOS shows a confirmation and a recording indicator the whole time."
          }
        }
      }
