    "cloud.consent.agree" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوافق"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Agree"
          }
        }
      }
    },
    "cloud.consent.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما لا يستطيع جهازك الترجمة، سيُرسل النص المقروء من الشاشة إلى Google لترجمته. لا تُرسل الصور. قد يحتوي النص على أي شيء ظاهر على الشاشة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your device cannot translate, text read from the screen will be sent to Google for translation. Images are not sent. The text can include anything visible on screen."
          }
        }
      }
    },
    "cloud.consent.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال النص إلى Google؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send text to Google?"
          }
        }
      }
    },
    "cloud.disable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقفها واحذف المفتاح"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn Off and Delete Key"
          }
        }
      }
    },
    "cloud.disable.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الإيقاف لا يُرسل أي نص خارج جهازك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After turning it off, no text leaves your device."
          }
        }
      }
    },
    "cloud.enable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق وفعّل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check and Turn On"
          }
        }
      }
    },
    "cloud.enabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة السحابية مفعّلة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud translation is on"
          }
        }
      }
    },
    "cloud.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم فقط عندما لا يستطيع جهازك الترجمة، مثل لغة غير مدعومة أو غير منزّلة. تحتاج إلى مفتاح Google Cloud Translation خاص بك، وقد تحاسبك Google على الاستخدام."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only when your device cannot translate, for example when a language is unsupported or not downloaded. You need your own Google Cloud Translation key, and Google may charge you for use."
          }
        }
      }
    },
    "cloud.key" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح API"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API key"
          }
        }
      }
    },
    "cloud.key.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ المفتاح في Keychain على هذا الجهاز فقط. عند التفعيل نجرّبه بكلمة ثابتة لا بنص من لعبتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key is kept in this device's Keychain only. When you turn this on, we test it with a fixed word, not with text from your game."
          }
        }
      }
    },
    "cloud.title" : {
