    "privacy.apple.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم الترجمة على الجهاز عبر إطار الترجمة من Apple، وقد ينزّل النظام حزم اللغات من Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device translation uses Apple's Translation framework, and iOS may download language packs from Apple."
          }
        }
      }
    },
    "privacy.apple.title" : {
      "extractionState" : "manual",
