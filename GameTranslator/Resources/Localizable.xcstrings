    "onboarding.live.point2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء البث يقرأ التطبيق النص الظاهر على الشاشة، أيًا كان التطبيق المفتوح. لا يُسجَّل فيديو ولا صوت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While it runs, the app reads text visible on screen, whichever app is open. No video or audio is recorded."
          }
        }
      }
    },
    "onboarding.live.point3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقفه من المؤشر أو من التطبيق عند الانتهاء، وقبل فتح أي شيء خاص مثل الرسائل أو البنك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop it from the indicator or in the app when you finish, and before opening anything private such as messages or your bank."
