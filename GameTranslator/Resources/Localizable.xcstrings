    "connect.stream_step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح اللعبة في تطبيق اللعب عن بُعد. بعض التطبيقات تمنع قراءة شاشتها، وعندها استخدم الكاميرا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the game in the remote play app. Some apps block screen reading; use the camera then."
          }
        }
      }
    },
    "connect.ways" : {
