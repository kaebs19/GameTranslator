    "privacy.apple.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم الترجمة على الجهاز عبر إطار الترجمة من Apple، وقد ينزّل النظام حزم اللغات من Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device translation uses Apple's Translation framework, and iOS may download language packs from Apple."
          }
        }
      }
    },
    "privacy.apple.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خدمات Apple"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Services"
          }
        }
      }
    },
    "privacy.broadcast.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدؤه وتوقفه أنت. يقرأ النص الظاهر على الشاشة فقط، ولا يُحفظ أي فيديو أو صوت أو صورة. ينتقل النص بين أجزاء التطبيق في ملفات مؤقتة على جهازك تُحذف بعد قراءتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You start and stop it. It only reads text visible on screen; no video, audio or image is saved. Text moves between parts of the app in temporary files on your device that are deleted once read."
          }
        }
      }
    },
    "privacy.broadcast.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البث والالتقاط المباشر"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broadcast and Live Capture"
          }
        }
      }
    },
    "privacy.camera.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم بعد إذنك لقراءة النص داخل المربع فقط. تُقرأ الصور في الذاكرة وتُحذف فورًا، ولا تُحفظ ولا تُرسل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used with your permission, only to read text inside the box. Frames are read in memory and dropped at once; they are not saved or sent."
          }
        }
      }
    },
    "privacy.camera.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكاميرا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera"
          }
        }
      }
    },
    "privacy.cloud.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقفة افتراضيًا. إذا فعّلتها بمفتاحك الخاص، يُرسل النص إلى Google عندما يتعذّر على جهازك ترجمته، وتسري عليه سياسة Google. لا تُرسل الصور. يُحفظ المفتاح في Keychain ويُحذف عند الإيقاف."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. If you turn it on with your own key, text is sent to Google when your device cannot translate it, under Google's policy. Images are never sent. The key is stored in the Keychain and deleted when you turn this off."
          }
        }
      }
    },
    "privacy.cloud.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة السحابية (اختيارية)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud Translation (Optional)"
          }
        }
      }
    },
    "privacy.contact.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا راسلتنا من صفحة «اتصل بنا» في موقعنا، نحفظ رسالتك والاسم والبريد إن كتبتهما، لنقرأها ونرد عليك فقط. لا نشاركها مع أحد، ونحذفها عند طلبك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you write to us through the contact page on our website, we keep your message and the name and email you choose to give, only to read it and reply. We do not share it, and we delete it when you ask."
          }
        }
      }
    },
    "privacy.contact.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسائل التواصل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contact Messages"
          }
        }
      }
    },
    "privacy.control.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك سحب أذونات الصور والكاميرا والإشعارات من إعدادات iPhone، ومسح الترجمات من إعدادات التطبيق. حذف التطبيق يحذف ملفاته. أوقف الترجمة السحابية وأزل التلفزيونات قبل الحذف لإزالة المفتاح ورموزها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can withdraw Photos, camera and notification permission in iPhone Settings and clear translations in the app's settings. Deleting the app deletes its files. Turn off cloud translation and remove TVs first to delete the key and their tokens."
          }
        }
      }
    },
    "privacy.control.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحكمك"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Control"
          }
        }
      }
    },
    "privacy.images.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقرأ الصورة التي تختارها أو آخر لقطة شاشة بعد إذنك، على جهازك فقط. لا نحفظ نسخة منها. تُحفظ الصورة المترجمة في الصور فقط عندما تضغط حفظ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We read the image you choose, or your latest screenshot with your permission, only on your device. We keep no copy. A translated image is saved to Photos only when you tap Save."
          }
        }
      }
    },
    "privacy.images.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصور ولقطات الشاشة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images and Screenshots"
          }
        }
      }
    },
    "privacy.server.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقفة افتراضيًا. إذا فعّلتها، يُرسل النص المقروء من وضع الكاميرا إلى خادم SubGG ليترجمه نموذج لغوي، وتُحفظ الترجمة في كاش مشترك لتُعاد لكل المستخدمين. وفي وضع اللعب عن بُعد مع التلفزيون، يُرسل نص ترجمة اللعبة المقروء من البث إلى الخادم ليُترجم ويصل إلى تلفزيونك المربوط، ثم لا يُحفظ إلا في الكاش المشترك. لا تُرسل الصور، ولا يُربط النص باسمك: يستخدم التطبيق رمز جهاز مجهول. قد يستعين الخادم بمزوّد ذكاء اصطناعي خارجي لترجمة النص."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. If you turn it on, text read in camera mode is sent to the SubGG server to be translated by a language model, and the translation is kept in a shared cache reused for all users. In Remote Play mode with a TV, the game's subtitle text read by the broadcast is sent to the server to be translated and delivered to your linked TV; it is kept only in the shared cache. Images are never sent and text is not linked to you: the app uses an anonymous device token. The server may use an outside AI provider to translate the text."
          }
        }
      }
    },
    "privacy.server.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة المحسّنة (اختيارية)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhanced Translation (Optional)"
          }
        }
      }
    },
    "privacy.summary.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا نجمع أي بيانات عنك. لا يوجد حساب ولا إعلانات ولا تحليلات. كل شيء يجري على جهازك، إلا إذا فعّلت الترجمة المحسّنة، فيُرسل النص المقروء وحده إلى خادمنا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We collect no data about you. There is no account, advertising or analytics. Everything happens on your device, unless you turn on enhanced translation, which sends only the text read to our server."
          }
        }
      }
    },
    "privacy.summary.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملخص"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summary"
          }
        }
      }
    },
    "privacy.text.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ على جهازك لعرضها في السجل وحتى لا تُترجم مرتين، في ملفات محمية ومستثناة من النسخ الاحتياطي. يمكنك إيقاف السجل من «التحكم بالترجمة» ومسحه من شاشته، ومسح الترجمات المحفوظة من الإعدادات. قد تظهر الترجمة في النشاط المباشر والإشعارات إن فعّلتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept on your device for history and so it is not translated twice, in protected files excluded from backups. You can turn history off in Translation Controls and clear it on its screen, and clear saved translations in Settings. Translations may appear in the Live Activity and in notifications if you turn them on."
          }
        }
      }
    },
    "privacy.text.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النصوص المترجمة والسجل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translated Text and History"
          }
        }
      }
    },
    "privacy.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سياسة الخصوصية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy"
          }
        }
      }
    },
    "privacy.tv.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف افتراضيًا. إذا فعّلته، يُرسل النص المترجم، والأصلي إن اخترت ذلك، إلى التلفزيونات التي اقترنت بها فقط، مباشرة داخل شبكتك المحلية ودون تشفير، ودون المرور بالإنترنت. لا تُرسل الصور. تُحفظ أسماء التلفزيونات ورموزها في Keychain، ويمكنك إزالتها من شاشة التلفزيون."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. If you turn it on, translated text, and the original if you choose, is sent only to TVs you paired, directly inside your local network and unencrypted, without passing through the internet. Images are never sent. TV names and tokens are stored in the Keychain; you can remove them on the TV screen."
          }
        }
      }
    },
