    "cloud.enabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة السحابية مفعّلة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud translation is on"
          }
        }
      }
    },
    "cloud.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم فقط عندما لا يستطيع جهازك الترجمة، مثل لغة غير مدعومة أو غير منزّلة. تحتاج إلى مفتاح Google Cloud Translation خاص بك، وقد تحاسبك Google على الاستخدام."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only when your device cannot translate, for example when a language is unsupported or not downloaded. You need your own Google Cloud Translation key, and Google may charge you for use."
          }
        }
      }
    },
    "cloud.key" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح API"
