          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحفظ صورك. يُحفظ النص وترجمته على جهازك في السجل ولتسريع الترجمة، ويمكنك مسحهما أو إيقاف السجل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your images are not kept. Text and translations stay on your device for history and speed. You can clear them or turn history off."
          }
