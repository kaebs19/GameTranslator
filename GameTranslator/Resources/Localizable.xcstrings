        }
      }
    },
    "cloud.key.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ المفتاح في Keychain على هذا الجهاز فقط. عند التفعيل نجرّبه بكلمة ثابتة لا بنص من لعبتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key is kept in this device's Keychain only. When you turn this on, we test it with a fixed word, not with text from your game."
          }
        }
      }
    },
