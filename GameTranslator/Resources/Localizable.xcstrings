    "cloud.consent.agree" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوافق"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Agree"
          }
        }
      }
    },
    "cloud.consent.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما لا يستطيع جهازك الترجمة، سيُرسل النص المقروء من الشاشة إلى Google لترجمته. لا تُرسل الصور. قد يحتوي النص على أي شيء ظاهر على الشاشة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your device cannot translate, text read from the screen will be sent to Google for translation. Images are not sent. The text can include anything visible on screen."
          }
        }
      }
    },
    "cloud.consent.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال النص إلى Google؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send text to Google?"
          }
        }
      }
    },
    "cloud.disable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقفها واحذف المفتاح"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn Off and Delete Key"
          }
        }
      }
    },
    "cloud.disable.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الإيقاف لا يُرسل أي نص خارج جهازك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After turning it off, no text leaves your device."
          }
        }
      }
    },
    "cloud.enable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
