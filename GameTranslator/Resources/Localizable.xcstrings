    "connect.stream_step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت تطبيق اللعب عن بُعد الخاص بجهازك واربطه به."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
