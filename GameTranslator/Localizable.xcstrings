      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح هذه الصورة. إن كانت في iCloud فنزّلها من تطبيق الصور أولًا."
