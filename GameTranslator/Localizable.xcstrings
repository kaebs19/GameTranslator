          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        }
      }
    },
    "error.photo_access_denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح للتطبيق بالوصول إلى الصور من إعدادات iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access to Photos in iPhone Settings."
          }
        }
      }
    },
    "error.photo_access_limited" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سمحت بالوصول إلى صور محددة فقط ولا توجد بينها لقطة شاشة. اسمح بالوصول الكامل من الإعدادات، أو اختر الصورة بنفسك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You allowed only selected photos and none is a screenshot. Allow full access in Settings, or choose the photo yourself."
          }
        }
      }
    },
    "error.retry" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد المحاولة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try Again"
          }
        }
      }
    },
    "error.same_language" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لغة اللعبة ولغة الترجمة متطابقتان. غيّر إحداهما من الإعدادات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game language and the translation language are the same. Change one in Settings."
          }
        }
      }
    },
